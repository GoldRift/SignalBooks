# Copy to .env and fill in. Never commit .env.

# The Signal number this bot's linked device belongs to (E.164, e.g. +15550000000).
SIGNAL_ACCOUNT=

# Comma-separated numbers allowed to talk to the bot in 1:1 chats (E.164).
SIGNAL_ALLOWED_NUMBERS=

# Optional: one Signal group whose members may use the bot. The base64 id comes
# from `signal-cli -a "$SIGNAL_ACCOUNT" listGroups`. Empty means groups are ignored.
SIGNAL_GROUP_ID=

# TorBox API key (paid plan required).
TORBOX_API_KEY=your-torbox-api-key

# Optional: AudiobookBay session cookie. The info hash is served anonymously,
# so leave empty unless a login gate or Cloudflare challenge returns.
ABB_COOKIE=

# Path to the signal-cli Unix socket. Already set in docker-compose.yml.
# SIGNAL_SOCKET=/run/signal-cli/socket
